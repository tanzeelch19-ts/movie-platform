PORT=5000
NODE_ENV=development
HOST=127.0.0.1

# At least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of allowed frontend origins, e.g. http://localhost:5173,https://reelist.vercel.app
CLIENT_URL=http://localhost:5173

TMDB_API_KEY=

# Secret for POST /api/cron/digest. Keep it private.
CRON_SECRET=

# Set to true when an external cron runs the digest, so it is not sent twice.
DISABLE_SCHEDULER=false

# Optional. Leave SMTP_HOST empty to log digests to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Reelist <no-reply@example.com>