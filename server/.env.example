PORT=5000
NODE_ENV=development
HOST=127.0.0.1

# At least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of allowed frontend origins, e.g. http://localhost:5173,https://movie-platform-ebon-xi.vercel.app
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (required). Use a separate database name for local development.
MONGO_URI=
MONGO_DB=reelist-dev

TMDB_API_KEY=

# Secret for the digest endpoint and Vercel Cron. Keep it private.
CRON_SECRET=

# Local server only. Vercel runs the digest through Vercel Cron instead.
DISABLE_SCHEDULER=false

# Optional. Leave SMTP_HOST empty to log digests to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Reelist <no-reply@example.com>